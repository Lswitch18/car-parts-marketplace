FROM jenkins/jenkins:lts

USER root

RUN apt-get update || true && \
    apt-get install -y maven docker.io --no-install-recommends || true && \
    apt-get clean || true

# Node.js 22.22+ (Vite 7 / react-router 8 / vitest 4 exigem >=22.22.0)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs --no-install-recommends || true && \
    apt-get clean || true && \
    node --version

RUN if [ -f /usr/bin/docker ]; then ln -sf /usr/bin/docker /usr/bin/dockerd; fi || true

RUN usermod -aG docker jenkins || true

USER jenkins
# Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe (substitua pelas suas chaves)
VITE_STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Edge secret do Supabase (não coloque em .env): supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_WEBHOOK_SECRET=

# App
APP_URL=http://localhost:5173

# Site canônico público (OBRIGATÓRIO em produção): base do callback OAuth
# web `${VITE_SITE_URL}/auth/callback`. O endereço-base de runtime
# (localhost, preview) NUNCA é usado como redirectTo em produção.
# Cadastre `${VITE_SITE_URL}/auth/callback` em
# Supabase > Authentication > URL Configuration > Redirect URLs.
VITE_SITE_URL=https://daig.jp

# Google OAuth (Web + iOS)
VITE_GOOGLE_CLIENT_ID=606997989793-k2cuig6n7v5iiddc2sqfp6acm7st62t9.apps.googleusercontent.com
VITE_GOOGLE_IOS_CLIENT_ID=606997989793-6dqib92de1r1v3jsdr0cvs2p9c1md0gm.apps.googleusercontent.com

# Edge secrets do Supabase (NUNCA em .env / bundle — configurar via: supabase secrets set <VAR>=<valor>)
# Redis/Upstash (usado pela edge function redis-cache — nunca expor no client)
# UPSTASH_REDIS_REST_URL=https://<realm>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<token>
# Servidor Ollama / IA (usado pela edge function ollama-proxy — nunca expor no client)
# OLLAMA_API_URL=https://<host>/api/chat
# OLLAMA_API_AUTH=Basic <base64>
# Chave OpenRouter (usada pela edge function analyze-part)
# OPENROUTER_API_KEY=sk-or-...
